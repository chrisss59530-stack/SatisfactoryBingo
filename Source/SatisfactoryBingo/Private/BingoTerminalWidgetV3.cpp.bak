namespace
{
    constexpr float W = 1674.f;
    constexpr float H = 939.f;
    const FLinearColor Orange(1.f, .55f, .10f, 1.f);
    const FLinearColor White(.96f, .96f, .96f, 1.f);
    UTexture2D* LoadV3Texture(const TCHAR* Name)
    {
        const FString AssetName(Name);
        const FString Folder =
            AssetName == TEXT("T_Bingo_Cadre_FICSIT")
                ? TEXT("Textures")
                : TEXT("V3Textures");
        const FString Path = FString::Printf(
            TEXT("/SatisfactoryBingo/Bingo/UI/%s/%s.%s"),
            *Folder, Name, Name);
        return LoadObject<UTexture2D>(nullptr, *Path);
    }
    void Place(UCanvasPanel* Canvas, UWidget* Child, float X, float Y, float Width, float Height, int32 Z = 0)
    {
        UCanvasPanelSlot* S = Canvas->AddChildToCanvas(Child);
        S->SetAutoSize(false);
        S->SetPosition(FVector2D(X, Y));
        S->SetSize(FVector2D(Width, Height));
        S->SetZOrder(Z);
    }
    UImage* Image(UWidgetTree* Tree, const TCHAR* Name)
    {
        UImage* Result = Tree->ConstructWidget<UImage>(UImage::StaticClass());
        if (UTexture2D* Texture = LoadV3Texture(Name)) Result->SetBrushFromTexture(Texture, false);
        return Result;
    }
    UTextBlock* Text(UWidgetTree* Tree, const FString& Value, int32 Size, FLinearColor Color)
    {
        UTextBlock* Result = Tree->ConstructWidget<UTextBlock>(UTextBlock::StaticClass());
        Result->SetText(FText::FromString(Value));
        Result->SetColorAndOpacity(FSlateColor(Color));
        FSlateFontInfo Font = Result->GetFont();
        Font.Size = Size;
        Result->SetFont(Font);
        Result->SetJustification(ETextJustify::Center);
        return Result;
    }
    UButton* TexturedButton(UWidgetTree* Tree, const TCHAR* TextureName, const FString& Label, int32 FontSize)
    {
        UButton* Button = Tree->ConstructWidget<UButton>(UButton::StaticClass());
        FButtonStyle Style = Button->GetStyle();
        Style.Normal.TintColor = FSlateColor(FLinearColor::White);
        Style.Hovered.TintColor = FSlateColor(FLinearColor::White);
        Style.Pressed.TintColor = FSlateColor(FLinearColor::White);
        Button->SetStyle(Style);
        UOverlay* Overlay = Tree->ConstructWidget<UOverlay>(UOverlay::StaticClass());
        UOverlaySlot* Art = Overlay->AddChildToOverlay(Image(Tree, TextureName));
        Art->SetHorizontalAlignment(HAlign_Fill);
        Art->SetVerticalAlignment(VAlign_Fill);
        UOverlaySlot* Caption = Overlay->AddChildToOverlay(Text(Tree, Label, FontSize, White));
        Caption->SetHorizontalAlignment(HAlign_Center);
        Caption->SetVerticalAlignment(VAlign_Center);
        Button->AddChild(Overlay);
        return Button;
    }
}

TSharedRef<SWidget> UBingoTerminalWidgetV3::RebuildWidget()
{
    if (WidgetTree && !WidgetTree->RootWidget) BuildInterface();
    return Super::RebuildWidget();
}

