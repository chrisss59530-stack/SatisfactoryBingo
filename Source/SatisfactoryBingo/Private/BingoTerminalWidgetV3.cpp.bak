            break;
        case 2:
            PhaseButton->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::SelectPhase3);
            break;
        case 3:
            PhaseButton->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::SelectPhase4);
            break;
