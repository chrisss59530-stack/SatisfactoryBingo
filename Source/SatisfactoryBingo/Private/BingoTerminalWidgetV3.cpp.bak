void UBingoTerminalWidgetV3::SelectPhase1()
{
    SelectDisplayedPhase(1);
}

void UBingoTerminalWidgetV3::SelectPhase2()
{
    SelectDisplayedPhase(2);
}

void UBingoTerminalWidgetV3::SelectPhase3()
{
    SelectDisplayedPhase(3);
}

void UBingoTerminalWidgetV3::SelectPhase4()
{
    SelectDisplayedPhase(4);
}

void UBingoTerminalWidgetV3::SelectPhase5()
{
    SelectDisplayedPhase(5);
}

void UBingoTerminalWidgetV3::SelectDisplayedPhase(int32 NewPhase)
{
    UWorld* World = GetWorld();
    if (!World) return;

    for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
    {
        ABingoSubsystem* Subsystem = *It;
        if (!IsValid(Subsystem)) continue;

        UBingoGameData* Data = Subsystem->GetBingoGameData();
        if (!IsValid(Data)) return;

        const int32 PhaseIndex = NewPhase - 1;

        if (!Data->Phases.IsValidIndex(PhaseIndex))
            return;

        if (NewPhase > Data->CurrentPhase)
            return;

        DisplayedPhase = NewPhase;
        SelectedCellIndex = INDEX_NONE;

        RefreshBingoProgress();
        RefreshCellStates();
        RefreshChallengeLabels();
        RefreshChallengeProgress();

        return;
    }
}
void UBingoTerminalWidgetV3::ShowBingoTab()
{
    for (UButton* Button : RewardPhaseButtons)
        if (Button) Button->SetVisibility(ESlateVisibility::Collapsed);
    for (UButton* PhaseButton : PhaseButtons)
        if (PhaseButton) PhaseButton->SetVisibility(ESlateVisibility::Visible);

    for (UButton* Cell : Cells)
        if (Cell) Cell->SetVisibility(ESlateVisibility::Visible);

    if (PhaseText) PhaseText->SetVisibility(ESlateVisibility::Visible);
    if (DetailsText) DetailsText->SetVisibility(ESlateVisibility::Visible);
    if (ProgressText) ProgressText->SetVisibility(ESlateVisibility::Visible);
    if (ProgressBar) ProgressBar->SetVisibility(ESlateVisibility::Visible);
    if (ChallengeProgressText) ChallengeProgressText->SetVisibility(ESlateVisibility::Visible);
    if (ChallengeProgressBar) ChallengeProgressBar->SetVisibility(ESlateVisibility::Visible);

    for (UWidget* Control : RewardControls)
        if (Control) Control->SetVisibility(ESlateVisibility::Collapsed);
}

void UBingoTerminalWidgetV3::SelectRewardPhase(int32 NewPhase)
{
    // Consultation uniquement : ne change pas CurrentPhase.
    DisplayedRewardPhase = FMath::Clamp(NewPhase, 1, 5);
    RefreshRewardPhase();
}

void UBingoTerminalWidgetV3::SelectRewardPhase1()
{
    SelectRewardPhase(1);
}

void UBingoTerminalWidgetV3::SelectRewardPhase2()
{
    SelectRewardPhase(2);
}

void UBingoTerminalWidgetV3::SelectRewardPhase3()
{
    SelectRewardPhase(3);
}

void UBingoTerminalWidgetV3::SelectRewardPhase4()
{
    SelectRewardPhase(4);
}

void UBingoTerminalWidgetV3::SelectRewardPhase5()
{
    SelectRewardPhase(5);
}
// BINGO_V3_REWARD_PHASE_STATUS_01
void UBingoTerminalWidgetV3::RefreshRewardPhase()
{
    int32 UnlockedPhase = 1;

    if (UWorld* World = GetWorld())
    {
        for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
        {
            if (IsValid(*It))
            {
                if (UBingoGameData* Data = It->GetBingoGameData())
                {
                    UnlockedPhase = FMath::Clamp(
                        Data->CurrentPhase, 1, 5
                    );
                }
                break;
            }
        }
    }

    for (int32 Index = 0; Index < RewardPhaseButtons.Num(); ++Index)
    {
        UButton* Button = RewardPhaseButtons[Index];
        if (!IsValid(Button)) continue;

        const int32 Phase = Index + 1;
        const bool bSelected = Phase == DisplayedRewardPhase;
        const bool bUnlocked = Phase <= UnlockedPhase;

        Button->SetBackgroundColor(
            bSelected
                ? FLinearColor(1.0f, 0.45f, 0.05f, 1.0f)
                : bUnlocked
                    ? FLinearColor(0.35f, 0.35f, 0.35f, 1.0f)
                    : FLinearColor(0.12f, 0.12f, 0.12f, 1.0f)
        );
    }

    const int32 Count = FMath::Min(
        RewardRows.Num(),
        RewardRowPhases.Num()
    );

    for (int32 Index = 0; Index < Count; ++Index)
    {
        if (!RewardRows[Index]) continue;

        RewardRows[Index]->SetVisibility(
            RewardRowPhases[Index] == DisplayedRewardPhase
                ? ESlateVisibility::Visible
                : ESlateVisibility::Collapsed
        );
    }
}
void UBingoTerminalWidgetV3::ShowRewardsTab()
{
    for (UButton* Button : RewardPhaseButtons)
        if (Button) Button->SetVisibility(ESlateVisibility::Visible);
    DisplayedRewardPhase = FMath::Clamp(
        DisplayedRewardPhase, 1, 5
    );

    RefreshRewardPhase();
    for (UButton* PhaseButton : PhaseButtons)
        if (PhaseButton) PhaseButton->SetVisibility(ESlateVisibility::Collapsed);

    for (UButton* Cell : Cells)
        if (Cell) Cell->SetVisibility(ESlateVisibility::Collapsed);

    if (PhaseText) PhaseText->SetVisibility(ESlateVisibility::Collapsed);
    if (DetailsText) DetailsText->SetVisibility(ESlateVisibility::Collapsed);
    if (ProgressText) ProgressText->SetVisibility(ESlateVisibility::Collapsed);
    if (ProgressBar) ProgressBar->SetVisibility(ESlateVisibility::Collapsed);
    if (ChallengeProgressText) ChallengeProgressText->SetVisibility(ESlateVisibility::Collapsed);
    if (ChallengeProgressBar) ChallengeProgressBar->SetVisibility(ESlateVisibility::Collapsed);

    for (UWidget* Control : RewardControls)
        if (Control) Control->SetVisibility(ESlateVisibility::Visible);
}

void UBingoTerminalWidgetV3::NativeConstruct()
{
    ChallengeDisplayedProgress = 0.0f;
    ChallengeTargetProgress = 0.0f;
    LoadCellTextures();
    Super::NativeConstruct();

    DisplayedProgress = 0.0f;
    TargetProgress = 0.0f;
    RefreshElapsed = 0.0f;
    CellAnimationValues.Init(1.0f, 25);
    CellAnimationTargets.Init(1.0f, 25);
    CellCurrentColors.Init(FLinearColor::White, 25);
    CellTargetColors.Init(FLinearColor::White, 25);
    CellPulseTime = 0.0f;

    RefreshBingoProgress();

    // Restaurer la derniere case selectionnee
    if (APlayerController* PC = GetOwningPlayer())
    {
        if (const int32* Previous =
            GBingoV3SelectedCells.Find(PC))
        {
            if (*Previous >= 0 && *Previous < Cells.Num())
            {
                SelectCell(*Previous);
            }
        }
    }}

void UBingoTerminalWidgetV3::NativeTick(
    const FGeometry& MyGeometry,
    float InDeltaTime)
{
    // Animation fluide de la progression individuelle.
    ChallengeDisplayedProgress = FMath::FInterpTo(
        ChallengeDisplayedProgress,
        ChallengeTargetProgress,
        InDeltaTime,
        5.0f
    );

    if (IsValid(ChallengeProgressBar))
    {
        ChallengeProgressBar->SetPercent(ChallengeDisplayedProgress);
    }

    Super::NativeTick(MyGeometry, InDeltaTime);
    AnimateCellStates(InDeltaTime);
    RefreshCellAnimations();

    for (int32 I = 0; I < Cells.Num(); ++I)
    {
        if (!IsValid(Cells[I]) ||
            !CellAnimationValues.IsValidIndex(I) ||
            !CellAnimationTargets.IsValidIndex(I))
        {
            continue;
        }

        CellAnimationValues[I] = FMath::FInterpTo(
            CellAnimationValues[I],
            CellAnimationTargets[I],
            InDeltaTime,
            8.0f
        );

        Cells[I]->SetRenderTransformPivot(FVector2D(0.5f, 0.5f));

        Cells[I]->SetRenderScale(
            FVector2D(
                CellAnimationValues[I],
                CellAnimationValues[I]
            )
        );
    }

    RefreshElapsed += InDeltaTime;

    if (RefreshElapsed >= 0.5f)
    {
        RefreshElapsed = 0.0f;
        RefreshBingoProgress();
        RefreshCellStates();
        RefreshChallengeProgress();
    }

    // Animation fluide de la barre.
    DisplayedProgress = FMath::FInterpTo(
        DisplayedProgress,
        TargetProgress,
        InDeltaTime,
        5.0f
    );

    if (IsValid(ProgressBar))
    {
        ProgressBar->SetPercent(DisplayedProgress);
    }
}

void UBingoTerminalWidgetV3::RefreshBingoProgress()
{
    UWorld* World = GetWorld();
    if (!World) return;

    ABingoSubsystem* Subsystem = nullptr;

    for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
    {
        Subsystem = *It;
        break;
    }

    if (!IsValid(Subsystem)) return;

    UBingoGameData* Data = Subsystem->GetBingoGameData();
    if (!IsValid(Data)) return;
    // BINGO_V3_DISPLAY_PHASE_SYNC_01
    if (DisplayedPhase == INDEX_NONE)
    {
        DisplayedPhase = Data->CurrentPhase;
    }


    const int32 PhaseIndex =
        FMath::Clamp(DisplayedPhase - 1, 0, 4);

    if (!Data->Phases.IsValidIndex(PhaseIndex)) return;

    const FBingoPhase& Phase = Data->Phases[PhaseIndex];

    int32 Completed = 0;

    for (const FBingoChallenge& Challenge : Phase.Challenges)
    {
        if (Challenge.bCompleted)
        {
            ++Completed;
        }
    }

    const int32 TotalChallenges = Phase.Challenges.Num();

    TargetProgress = TotalChallenges > 0
        ? FMath::Clamp(
            static_cast<float>(Completed) /
                static_cast<float>(TotalChallenges),
            0.0f,
            1.0f
        )
        : 0.0f;

    if (IsValid(ProgressText))
    {
        ProgressText->SetText(FText::FromString(
            FString::Printf(
                TEXT("PROGRESSION : %d / %d"),
                Completed,
                TotalChallenges
            )
        ));
    }

    if (IsValid(PhaseText))
    {
        PhaseText->SetText(FText::FromString(
            FString::Printf(
                TEXT("PHASE %d / 5"),
                DisplayedPhase
            )
        ));
    }

    if (IsValid(PointsText))
    {
        PointsText->SetText(FText::FromString(
            FString::Printf(
                TEXT("POINTS BINGO : %d"),
                Subsystem->GetTotalBingoPoints()
            )
        ));
    }
}
void UBingoTerminalWidgetV3::RefreshCellAnimations()
{
    for (int32 I = 0; I < Cells.Num(); ++I)
    {
        if (!IsValid(Cells[I]) ||
            !CellAnimationTargets.IsValidIndex(I))
        {
            continue;
        }

        CellAnimationTargets[I] =
            Cells[I]->IsHovered() ? 1.06f : 1.0f;
    }
}

void UBingoTerminalWidgetV3::SelectCell(int32 Index)
{
    if (Index < 0 || Index >= Cells.Num())
    {
        return;
    }

    SelectedCellIndex = Index;
    RefreshChallengeProgress();

    if (APlayerController* PC = GetOwningPlayer())
    {
        GBingoV3SelectedCells.Add(PC, Index);
    }

    ABingoSubsystem* Subsystem = nullptr;

    if (UWorld* World = GetWorld())
    {
        for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
        {
            Subsystem = *It;
            break;
        }
    }

    FString Message = FString::Printf(
        TEXT("PHASE - CASE %02d"), Index + 1
    );

    if (IsValid(Subsystem))
    {
        UBingoGameData* Data = Subsystem->GetBingoGameData();

        if (IsValid(Data) &&
            Data->Phases.IsValidIndex(DisplayedPhase - 1))
        {
            const FBingoPhase& Phase =
                Data->Phases[DisplayedPhase - 1];

            if (Phase.Challenges.IsValidIndex(Index))
            {
                const FBingoChallenge& Challenge =
                    Phase.Challenges[Index];

                Message = FString::Printf(
                    TEXT("PHASE %d - CASE %02d\n%s\n%s"),
                    DisplayedPhase,
                    Index + 1,
                    *Challenge.Description.ToString(),
                    Challenge.bCompleted
                        ? TEXT("TERMINE")
                        : TEXT("A REALISER")
                );
            }
        }
    }

    if (IsValid(DetailsText))
    {
        DetailsText->SetAutoWrapText(true);
        DetailsText->SetText(FText::FromString(Message));
    }

    RefreshCellStates();
}

void UBingoTerminalWidgetV3::RefreshCellStates()
{
    RefreshChallengeLabels();
    RefreshChallengeProgress();
    RefreshCellTextures();
    ABingoSubsystem* Subsystem = nullptr;

    if (UWorld* World = GetWorld())
    {
        for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
        {
            Subsystem = *It;
            break;
        }
    }

    if (!IsValid(Subsystem)) return;

    UBingoGameData* Data = Subsystem->GetBingoGameData();
    if (!IsValid(Data)) return;

    if (!Data->Phases.IsValidIndex(DisplayedPhase - 1))
        return;

    const FBingoPhase& Phase =
        Data->Phases[DisplayedPhase - 1];

    for (int32 I = 0; I < Cells.Num(); ++I)
    {
        if (!IsValid(Cells[I])) continue;

        bool bCompleted = false;

        if (Phase.Challenges.IsValidIndex(I))
        {
            bCompleted = Phase.Challenges[I].bCompleted;
        }

        const bool bSelected = SelectedCellIndex == I;

        // Transition de couleur native UMG.
        const FLinearColor Color =
            bCompleted
                ? FLinearColor(0.35f, 1.0f, 0.35f, 1.0f)
                : bSelected
                    ? FLinearColor(1.0f, 0.55f, 0.10f, 1.0f)
                    : FLinearColor::White;

        if (CellTargetColors.IsValidIndex(I))
        {
            CellTargetColors[I] = Color;
        }
    }
}
