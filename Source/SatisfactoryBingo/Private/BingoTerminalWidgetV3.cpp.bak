    Place(Canvas, Image(WidgetTree, TEXT("T_Bingo_Cadre_FICSIT")), 0, 0, W, H, 1);
    Place(Canvas, Image(WidgetTree, TEXT("Panneau_Gauche_Fond")), 115, 216, 365, 580, 1);
    Place(Canvas, Image(WidgetTree, TEXT("Panneau_Droit_Fond")), 1174, 216, 346, 465, 1);

    UButton* BingoTab = TexturedButton(WidgetTree, TEXT("Onglet_Orange"), TEXT("BINGO"), 28);
    Place(Canvas, BingoTab, 173, 117, 408, 62, 5);
    BingoTab->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::ShowBingoTab);
    UButton* RewardsTab = TexturedButton(WidgetTree, TEXT("Onglet_Gris"), TEXT("RECOMPENSES"), 26);
    Place(Canvas, RewardsTab, 600, 117, 380, 62, 5);
    RewardsTab->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::ShowRewardsTab);

    // BINGO_V3_PHASE_BUTTONS_01
