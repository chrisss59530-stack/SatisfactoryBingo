            case 16: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked16); break;
            case 17: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked17); break;
            case 18: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked18); break;
            case 19: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked19); break;
            case 20: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked20); break;
            case 21: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked21); break;
            case 22: Cell->OnClicked.AddDynamic(this, &UBingoTerminalWidgetV3::OnCellClicked22); break;
