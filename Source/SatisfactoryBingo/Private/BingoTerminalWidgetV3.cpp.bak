    PointsText = Text(WidgetTree, TEXT("POINTS BINGO : --"), 25, Orange);
    Place(Canvas, PointsText, 1210, 132, 290, 42, 6);
    PhaseText = Text(WidgetTree, TEXT("PHASE 1 / 5"), 29, White);
    Place(Canvas, PhaseText, 135, 230, 310, 50, 6);

    ProgressText = Text(
