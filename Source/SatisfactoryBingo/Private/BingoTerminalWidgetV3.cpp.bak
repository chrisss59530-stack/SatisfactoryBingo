void UBingoTerminalWidgetV3::AnimateCellStates(float DeltaTime)
{
    CellPulseTime += DeltaTime;

    for (int32 I = 0; I < Cells.Num(); ++I)
    {
        if (!IsValid(Cells[I]) ||
            !CellCurrentColors.IsValidIndex(I) ||
            !CellTargetColors.IsValidIndex(I))
        {
            continue;
        }

        CellCurrentColors[I] = FMath::CInterpTo(
            CellCurrentColors[I],
            CellTargetColors[I],
            DeltaTime,
            6.0f
        );

        const bool bSelected = SelectedCellIndex == I;

        FLinearColor AnimatedColor = CellCurrentColors[I];

        if (bSelected)
        {
            const float Pulse =
                0.90f + 0.10f *
                FMath::Sin(CellPulseTime * 4.0f);

            AnimatedColor.R *= Pulse;
            AnimatedColor.G *= Pulse;
            AnimatedColor.B *= Pulse;
        }

        Cells[I]->SetColorAndOpacity(AnimatedColor);
    }
}

void UBingoTerminalWidgetV3::LoadCellTextures()
{
    CellNormalTexture = LoadObject<UTexture2D>(
        nullptr,
        TEXT("/SatisfactoryBingo/Bingo/UI/V3Textures/Case_Normale.Case_Normale")
    );

    CellActiveTexture = LoadObject<UTexture2D>(
        nullptr,
        TEXT("/SatisfactoryBingo/Bingo/UI/V3Textures/Case_Active.Case_Active")
    );

    CellCompletedTexture = LoadObject<UTexture2D>(
        nullptr,
        TEXT("/SatisfactoryBingo/Bingo/UI/V3Textures/Case_Terminee.Case_Terminee")
    );
}

void UBingoTerminalWidgetV3::RefreshCellTextures()
{
    ABingoSubsystem* Subsystem = nullptr;

    if (UWorld* World = GetWorld())
    {
        for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
        {
            Subsystem = *It;
            break;
        }
    }

    if (!IsValid(Subsystem))
    {
        return;
    }

    UBingoGameData* Data = Subsystem->GetBingoGameData();

    if (!IsValid(Data) ||
        !Data->Phases.IsValidIndex(DisplayedPhase - 1))
    {
        return;
    }

    const FBingoPhase& Phase =
        Data->Phases[DisplayedPhase - 1];

    for (int32 I = 0; I < Cells.Num(); ++I)
    {
        if (!IsValid(Cells[I]))
        {
            continue;
        }

        bool bCompleted = false;

        if (Phase.Challenges.IsValidIndex(I))
        {
            bCompleted = Phase.Challenges[I].bCompleted;
        }

        UTexture2D* DesiredTexture = CellNormalTexture;

        if (bCompleted)
        {
            DesiredTexture = CellCompletedTexture;
        }
        else if (SelectedCellIndex == I)
        {
            DesiredTexture = CellActiveTexture;
        }

        if (!IsValid(DesiredTexture))
        {
            continue;
        }

        // Retrouver l'image native dans le contenu du bouton.
        UOverlay* Overlay =
            Cast<UOverlay>(Cells[I]->GetContent());

        if (!IsValid(Overlay))
        {
            continue;
        }

        for (UPanelSlot* PanelSlot : Overlay->GetSlots())
        {
            UWidget* Child = PanelSlot ? PanelSlot->Content : nullptr;

            UImage* Image = Cast<UImage>(Child);

            if (IsValid(Image))
            {
                Image->SetBrushFromTexture(
                    DesiredTexture,
                    false
                );

                break;
            }
        }
    }
}

void UBingoTerminalWidgetV3::RefreshChallengeProgress()
{
    if (!IsValid(ChallengeProgressText))
    {
        return;
    }

    if (SelectedCellIndex == INDEX_NONE)
    {
        ChallengeTargetProgress = 0.0f;

        ChallengeProgressText->SetText(
            FText::FromString(TEXT("SELECTIONNEZ UN DEFI"))
        );

        return;
    }

    ABingoSubsystem* Subsystem = nullptr;

    if (UWorld* World = GetWorld())
    {
        for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
        {
            Subsystem = *It;
            break;
        }
    }

    if (!IsValid(Subsystem))
    {
        ChallengeTargetProgress = 0.0f;

        ChallengeProgressText->SetText(
            FText::FromString(TEXT("DONNEES INDISPONIBLES"))
        );

        return;
    }

    UBingoGameData* Data = Subsystem->GetBingoGameData();

    if (!IsValid(Data) ||
        !Data->Phases.IsValidIndex(DisplayedPhase - 1))
    {
        ChallengeTargetProgress = 0.0f;

        ChallengeProgressText->SetText(
            FText::FromString(TEXT("PHASE INDISPONIBLE"))
        );

        return;
    }

    const FBingoPhase& Phase =
        Data->Phases[DisplayedPhase - 1];

    if (!Phase.Challenges.IsValidIndex(SelectedCellIndex))
    {
        ChallengeTargetProgress = 0.0f;

        ChallengeProgressText->SetText(
            FText::FromString(TEXT("DEFI INDISPONIBLE"))
        );

        return;
    }

    const FBingoChallenge& Challenge =
        Phase.Challenges[SelectedCellIndex];

    // BINGO_V3_REAL_BIOMASS_PROGRESS_01
    if (DisplayedPhase == 1 && SelectedCellIndex == 20)
    {
        const int32 Current = Challenge.bCompleted
            ? 500
            : FMath::Clamp(
                Subsystem->BingoWoodBiomassProduced, 0, 500
            );

        ChallengeTargetProgress =
            static_cast<float>(Current) / 500.0f;

        ChallengeProgressText->SetText(
            FText::FromString(
                FString::Printf(
                    TEXT("BIOMASSE BOIS : %d / 500"),
                    Current
                )
            )
        );

        return;
    }

    const int32 Completed = Challenge.bCompleted ? 1 : 0;

    ChallengeTargetProgress = static_cast<float>(Completed);

    ChallengeProgressText->SetText(
        FText::FromString(
            FString::Printf(
                TEXT("PROGRESSION DU DEFI : %d / 1"),
                Completed
            )
        )
    );
}

// BINGO_V3_INPUT_AND_SELECTION_01
bool UBingoTerminalWidgetV3::NativeCanCallInit()
{
    UE_LOG(LogTemp, Warning,
        TEXT("[BINGO_UI] NativeCanCallInit"));

    return true;
}

void UBingoTerminalWidgetV3::Init_Implementation()
{
    UE_LOG(LogTemp, Warning,
        TEXT("[BINGO_UI] Init ENTER"));

    Super::Init_Implementation();

    UE_LOG(LogTemp, Warning,
        TEXT("[BINGO_UI] Init OK"));
}

void UBingoTerminalWidgetV3::OnPushedToGameUI_Implementation()
{
    UE_LOG(LogTemp, Warning,
        TEXT("[BINGO_UI] OnPushedToGameUI ENTER"));

    Super::OnPushedToGameUI_Implementation();

    SetInputMode_Implementation();

    UE_LOG(LogTemp, Warning,
        TEXT("[BINGO_UI] OnPushedToGameUI OK"));
}

void UBingoTerminalWidgetV3::SetInputMode_Implementation()
{
    Super::SetInputMode_Implementation();

    APlayerController* PC = GetOwningPlayer();
    if (!PC)
    {
        return;
    }

    PC->bShowMouseCursor = true;
    PC->SetIgnoreLookInput(true);
    PC->SetIgnoreMoveInput(true);

    FInputModeGameAndUI InputMode;
    InputMode.SetWidgetToFocus(TakeWidget());
    InputMode.SetHideCursorDuringCapture(false);
    InputMode.SetLockMouseToViewportBehavior(
        EMouseLockMode::DoNotLock
    );

    PC->SetInputMode(InputMode);
    SetKeyboardFocus();
}

void UBingoTerminalWidgetV3::CloseBingoTerminal()
{
    AFGPlayerController* PC =
        Cast<AFGPlayerController>(GetOwningPlayer());

    if (!PC)
    {
        return;
    }

    UFGGameUI* GameUI = PC->GetGameUI();

    if (GameUI)
    {
        GameUI->PopWidget(this);
    }
}

FReply UBingoTerminalWidgetV3::NativeOnPreviewKeyDown(
    const FGeometry& InGeometry,
    const FKeyEvent& InKeyEvent)
{
    APlayerController* PC = GetOwningPlayer();

    if (!PC)
    {
        return Super::NativeOnPreviewKeyDown(
            InGeometry, InKeyEvent
        );
    }

    // BINGO_ESCAPE_CLOSE_FIX_01
    if (InKeyEvent.GetKey() == EKeys::Escape)
    {
        CloseBingoTerminal();
        return FReply::Handled();
    }
    FKey UseKey;
    TArray<FKey> Modifiers;

    const bool bFound =
        UFGInputLibrary::GetCurrentMappingForAction(
            PC,
            FName(TEXT("PlayerActions_Use")),
            UseKey,
            Modifiers
        );

    if (bFound && InKeyEvent.GetKey() == UseKey)
    {
        bool bModifiersValid = true;

        for (const FKey& Modifier : Modifiers)
        {
            if ((Modifier == EKeys::LeftShift ||
                 Modifier == EKeys::RightShift) &&
                !InKeyEvent.IsShiftDown())
            {
                bModifiersValid = false;
            }

            if ((Modifier == EKeys::LeftControl ||
                 Modifier == EKeys::RightControl) &&
                !InKeyEvent.IsControlDown())
            {
                bModifiersValid = false;
            }

            if ((Modifier == EKeys::LeftAlt ||
                 Modifier == EKeys::RightAlt) &&
                !InKeyEvent.IsAltDown())
            {
                bModifiersValid = false;
            }

            if ((Modifier == EKeys::LeftCommand ||
                 Modifier == EKeys::RightCommand) &&
                !InKeyEvent.IsCommandDown())
            {
                bModifiersValid = false;
            }
        }

        if (bModifiersValid)
        {
            CloseBingoTerminal();
            return FReply::Handled();
        }
    }

    return Super::NativeOnPreviewKeyDown(
        InGeometry, InKeyEvent
    );
}
// BINGO_V3_CHALLENGE_LABELS_01

void UBingoTerminalWidgetV3::RefreshChallengeLabels()
{
    UWorld* World = GetWorld();
    if (!World) return;

    ABingoSubsystem* Subsystem = nullptr;

    for (TActorIterator<ABingoSubsystem> It(World); It; ++It)
    {
        Subsystem = *It;
        break;
    }

    if (!IsValid(Subsystem)) return;

    UBingoGameData* Data = Subsystem->GetBingoGameData();
    if (!IsValid(Data)) return;

    const int32 PhaseIndex = (DisplayedPhase == INDEX_NONE ? Data->CurrentPhase : DisplayedPhase) - 1;

    if (!Data->Phases.IsValidIndex(PhaseIndex))
        return;

    const FBingoPhase& Phase = Data->Phases[PhaseIndex];

    for (int32 I = 0; I < CellLabels.Num(); ++I)
    {
        UTextBlock* Label = CellLabels[I];

        if (!IsValid(Label)) continue;
        if (!Phase.Challenges.IsValidIndex(I)) continue;

        const FString Description =
            Phase.Challenges[I].Description.ToString();

        int32 FontSize = 10;

        if (Description.Len() > 80)
            FontSize = 8;
        else if (Description.Len() > 55)
            FontSize = 8;
        else if (Description.Len() > 30)
            FontSize = 10;

        FSlateFontInfo Font = Label->GetFont();
        Font.Size = FontSize;

        Label->SetFont(Font);
        Label->SetAutoWrapText(true);
        Label->SetWrapTextAt(102.0f);
        Label->SetJustification(ETextJustify::Center);
        Label->SetText(FText::FromString(Description.Len() > 48 ? Description.Left(45) + TEXT("...") : Description));
    }
}